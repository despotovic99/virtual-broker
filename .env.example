# Promenljive za docker-compose (samo lokalni razvoj).
# Kopirati u .env i promeniti lozinke. .env se ne commit-uje.

POSTGRES_USER=virtual_broker
POSTGRES_PASSWORD=promeni-me-postgres
POSTGRES_DB=virtual_broker

REDIS_PASSWORD=promeni-me-redis

# MinIO traži lozinku od najmanje 8 znakova.
MINIO_ROOT_USER=virtual-broker
MINIO_ROOT_PASSWORD=promeni-me-minio
S3_BUCKET=virtual-broker-dev

# Tajna za potpisivanje access tokena (JWT), najmanje 32 bajta.
# Generisanje: openssl rand -base64 48
JWT_ACCESS_SECRET=promeni-me-najmanje-32-bajta-nasumicnih-znakova

# Portovi na hostu (vezani samo za 127.0.0.1).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=3000
API_DEBUG_HOST_PORT=9229
CLIENT_HOST_PORT=5173
